{
  "name": "handslab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "HandsLab - OpenHands 深度解析与 AI Software Engineering Agent 实战教程",
  "scripts": {
    "predev": "node scripts/generate-manifest.mjs && node scripts/generate-diagrams.mjs",
    "dev": "vite",
    "prebuild": "node scripts/generate-manifest.mjs && node scripts/generate-diagrams.mjs",
    "build": "tsc --noEmit && vite build",
