    "diagrams": "node scripts/generate-diagrams.mjs",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "dependencies": {
    "highlight.js": "^11.11.1",
    "marked": "^15.0.6"
  }
}
